# ===== Server / Express =====
PORT=4000
# Frontend origin allowed by CORS (must match the running frontend dev server)
CLIENT_ORIGIN=http://localhost:8080

# ===== Database =====
MONGODB_URI=

# ===== Cookie / Session signing =====
COOKIE_SECRET=

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# ===== Stripe =====
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd
STRIPE_STORAGE_UPGRADE_AMOUNT=499

# ===== Email / SMTP (OTP delivery) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@storageapp.com
